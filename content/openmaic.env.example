# 复制为 content/openmaic.env 后填写。这个文件只在你的电脑上使用，不要提交到 git。
# 它会被复制成本地 OpenMAIC 的 .env.local；所有变量名与 OpenMAIC v1.1.0 的 .env.example 一致。

# ---- 方案 A（推荐）：阿里云百炼一个 Key 同时负责出课件和配音 ----
QWEN_API_KEY=
DEFAULT_MODEL=qwen:qwen3.7-plus
TTS_QWEN_API_KEY=
# 百炼的配音默认音色是 Cherry（女声，亲切自然）

# ---- 方案 B：DeepSeek 出课件 + MiniMax 配音 ----
# DEEPSEEK_API_KEY=
# DEFAULT_MODEL=deepseek:deepseek-v4-flash
# TTS_MINIMAX_API_KEY=
# TTS_MINIMAX_BASE_URL=https://api.minimaxi.com

# 只配置一个 TTS Key：OpenMAIC 会使用第一个可用的语音服务。

# ---- 方案 C：不装 Docker，直接用 OpenMAIC 官方托管版（open.maic.chat）----
# 在 open.maic.chat 登录 → 右上角账号 → 访问码设置 → 生成访问码（sk- 开头）。
# 每天最多生成 10 节课，用完后脚本会自动停下，第二天接着跑。上面的模型 / 语音 Key 在这个方案里不需要。
# XUEXI_OPENMAIC_URL=https://open.maic.chat
# ACCESS_CODE=sk-

# ---- 生成脚本自己的设置 ----
# OpenMAIC 地址（默认 http://localhost:3000；用 pnpm content mock 时也是这个地址）
# XUEXI_OPENMAIC_URL=http://localhost:3000
# 设为 0 可以关闭配音（讲解时按字幕阅读时长自动翻页）
# XUEXI_ENABLE_TTS=1

# ---- 国内网络构建加速（可选，传给 OpenMAIC 的 Docker 构建）----
# ALPINE_MIRROR=mirrors.tuna.tsinghua.edu.cn
# NPM_REGISTRY=https://registry.npmmirror.com

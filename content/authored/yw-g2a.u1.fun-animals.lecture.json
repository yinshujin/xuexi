    {
     "id": "t1",
     "kind": "text",
     "text": "例：青蛙，绿衣裳，白肚皮，小时候是小蝌蚪。"
    }
   ],
   "script": [
    {
     "say": "介绍动物，可以分三步走。"
    },
    {
     "laser": "c1a"

          "question": "50600000 ○ 5060000，○ 里应该填什么？",
          "options": [
            ">",
            "<",
            "="
          ],
          "answer": [
            0
          ],
          "analysis": "50600000 是 8 位数，5060000 是 7 位数，位数多的数大，所以 50600000 > 5060000。"
        },
        {
          "question": "判断：986000 比 1180000 大，因为 9 比 1 大。",
          "options": [
            "对",
            "错"
          ],
          "answer": [
            1
          ],
          "analysis": "986000 是六位数，1180000 是七位数，要先比位数，所以 1180000 > 986000。"
        },
        {
          "question": "把 450900、459000、45900 从大到小排列，正确的是哪一个？",
          "options": [
            "459000 > 450900 > 45900",
            "450900 > 459000 > 45900",
            "45900 > 459000 > 450900"
          ],
          "answer": [
            0
          ],
          "analysis": "45900 只有 5 位，最小。450900 和 459000 都是 6 位，十万位和万位都相同，再比千位：9 比 0 大，所以 459000 更大。"
        },
        {
          "question": "最大的五位数和最小的六位数，哪个大？",
          "options": [
            "最大的五位数",
            "最小的六位数",
            "一样大"
          ],
          "answer": [
            1
          ],
          "analysis": "最大的五位数是 99999，最小的六位数是 100000，位数多的数大；而且 99999 + 1 = 100000。"
        }
      ]

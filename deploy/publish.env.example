# Variables for `pnpm content publish --target edgeone|tencent`.
# Copy to content/publish.env (git-ignored) and fill in. It holds secrets.
# The content CLI loads this file and then runs
#   bash deploy/edgeone/deploy.sh <siteDir>
#   bash deploy/tencent/deploy.sh <siteDir>        (add --init for first-time server setup)

# ---------------------------------------------------------------------------
# Target: edgeone  (EdgeOne Pages free plan, see deploy/edgeone/README.md)
# ---------------------------------------------------------------------------
# API token: EdgeOne Pages console -> "API Token" tab -> create.
EDGEONE_API_TOKEN=
# Pages project name (lowercase letters, digits, '-'); created on first deploy.
EDGEONE_PROJECT=xuexi-family
# production | preview
EDGEONE_ENV=production
# Only used when the project is created by the first deploy:
#   overseas = 全球可用区（不含中国大陆）, custom domain needs no ICP 备案
#   global   = 全球可用区（含中国大陆）, custom domain must have ICP 备案
EDGEONE_AREA=overseas
# npm version/range of the edgeone CLI run through npx
EDGEONE_CLI_VERSION=1
# FAMILY_CODE / TOKEN_SECRET and the KV binding are set in the EdgeOne console,
# not here (Project -> Settings -> Environment variables / KV Storage).

# ---------------------------------------------------------------------------
# Target: tencent  (Lighthouse server + Docker, see deploy/tencent/README.md)
# ---------------------------------------------------------------------------
# ssh target of the server
TENCENT_HOST=ubuntu@1.2.3.4
# optional: private key file (default: your ssh agent / ~/.ssh config)
TENCENT_SSH_KEY=
# optional: ssh port (default 22)
TENCENT_SSH_PORT=22
# optional: install directory on the server (default /srv/xuexi)
TENCENT_REMOTE_DIR=/srv/xuexi
# Only read by `deploy.sh --init` when the server has no .env yet; afterwards
# edit /srv/xuexi/.env on the server instead.
SITE_DOMAIN=
FAMILY_CODE=
# leave empty to generate one on the server
TOKEN_SECRET=

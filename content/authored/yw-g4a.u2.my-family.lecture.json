    {
      "type": "quiz",
      "title": "填空与积累运用",
      "intro": "最后是填空题。",
      "questions": [
        {
          "question": "写人要抓住人物最突出的（　）。",
          "options": [
            "特点",
            "名字",
            "年龄"
          ],
          "answer": [
            0
          ],
          "analysis": "抓住最突出的特点，人物才鲜明。"
        },
        {
          "question": "用一两件具体的（　）来表现特点。",
          "options": [
            "事例",

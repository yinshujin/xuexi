        {
          "id": "g1",
          "kind": "table",
          "rows": [
            [
              "路标词",
              "哪一段"
            ],
            [
              "午后一点左右",
              "潮来时"
            ],
            [
              "过了一会儿",
              "潮来时"
            ],
            [
              "霎时",
              "潮头过后"
            ],
            [

      "questions": [
        {
          "question": "“桌上放着一个又大又红的苹果。”比“桌上放着一个苹果。”写得更具体。",
          "options": [
            "对",
            "错"
          ],
          "answer": [
            0
          ],
          "analysis": "对。“又大又红”写出了苹果的大小和颜色。"
        },
        {
          "question": "“小乌龟慢慢的爬。”里的“的”用对了。",
          "options": [
            "对",
            "错"
          ],
          "answer": [
            1
          ],
          "analysis": "错。爬是动作，要用土字旁的“地”：慢慢地爬。"
        },
        {
          "question": "好词用得越多越好，一句话里可以连着用好几个意思一样的词。",
          "options": [
            "对",
            "错"
          ],
          "answer": [
            1
          ],
          "analysis": "错。意思一样的词堆在一起很啰嗦，挑一个最合适的就够了。"
        }

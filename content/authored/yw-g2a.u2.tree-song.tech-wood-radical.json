      "blocks": [
        {"id": "h1", "kind": "heading", "text": "这一笔，写对了吗？"},
        {"id": "t1", "kind": "text", "text": "木字旁：横、竖、撇、点（不是捺）"},
        {"id": "c1", "kind": "cards", "items": [
          {"id": "c1a", "text": "木字站左边，", "color": "blue"},

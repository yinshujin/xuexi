        { "id": "c1", "kind": "cards", "items": [
          { "id": "c1a", "text": "eagle 老鹰", "color": "orange" },
          { "id": "c1b", "text": "owl 猫头鹰", "color": "purple" },
          { "id": "c1c", "text": "honeybee 蜜蜂", "color": "green" }
        ] },
        { "id": "l1", "kind": "bullets", "items": [
          "老鹰：飞得很高",
          "猫头鹰：晚上醒着",
          "蜜蜂：会做蜂蜜"
        ] }
      ],
      "script": [
        { "say": "先看第一种动物，它飞得又高又快，是老鹰。跟我读。" },
        { "laser": "c1a" },
        { "say": "eagle, eagle", "lang": "en" },
        { "say": "第二种动物白天睡觉，晚上醒着捉老鼠，是猫头鹰。跟我读。" },
        { "laser": "c1b" },
        { "say": "owl, owl", "lang": "en" },
        { "say": "第三种动物小小的，会做甜甜的蜂蜜，是蜜蜂。跟我读。" },
        { "laser": "c1c" },
        { "say": "honeybee, honeybee", "lang": "en" },
        { "say": "蜜蜂这个词很长，它是蜂蜜和蜜蜂两个小词拼在一起的。" },
        { "say": "honey, bee, honeybee", "lang": "en" },
        { "spotlight": "l1" },
        { "say": "记住它们的本领：老鹰飞得高，猫头鹰晚上醒着，蜜蜂会做蜂蜜。" }
      ]
    },

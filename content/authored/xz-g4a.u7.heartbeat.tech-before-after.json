{
  "format": "xuexi-authored@1",
  "lessonId": "xz-g4a.u7.heartbeat.tech-before-after",
  "title": "心情前后对比",
  "scenes": [
    {
      "type": "slide",
      "title": "方法：对比写变化",
      "blocks": [
        {
          "id": "h1",
          "kind": "heading",
          "text": "对比写变化"
        },
        {
          "id": "t1",
          "kind": "text",
          "text": "同一个细节，写之前，也写之后"
        }
      ],
      "script": [
        {
          "say": "写心情，不但要写出紧张、激动，还要写出心情的变化。"
        },
        {
          "spotlight": "t1"
        },
        {
          "say": "好办法是前后对比：选同一个细节，写之前的样子，也写之后的样子。"
        },
        {
          "say": "一对比，变化就藏不住了。"
        }
      ]
    },
    {
      "type": "slide",
      "title": "演示两个例子",
      "blocks": [
        {
          "id": "h1",
          "kind": "heading",
          "text": "看两个例子"
        },
        {
          "id": "t1",
          "kind": "text",
          "text": "例一：讲稿　例二：操场"
        }
      ],
      "script": [
        {
          "say": "例一，国旗下讲话的讲稿。"
        },
        {
          "boardClear": true
        },
        {
          "board": [
            {
              "text": "之前：讲稿被我攥得皱巴巴的；"
            },
            {
              "text": "之后：我把它小心地抚平，夹进了日记本。"
            }
          ]
        },
        {
          "say": "同一张讲稿，一攥一抚，从紧张到珍惜。"
        },
        {
          "say": "不用说“我不紧张了”，读者也看得出来。"
        },
        {
          "say": "例二，同一个操场。"
        },
        {
          "boardClear": true
        },
        {
          "board": [
            {
              "text": "之前：操场大得吓人，全是眼睛；"
            },
            {
              "text": "之后：我这才发现，天空那么蓝。"
            }
          ]
        },
        {
          "say": "心情变了，看到的景物也跟着变了。"
        },
        {
          "boardClose": true
        }
      ]
    },
    {
      "type": "slide",
      "title": "常见错误",
      "blocks": [
        {
          "id": "h1",
          "kind": "heading",
          "text": "常见错误"
        },
        {
          "id": "t1",
          "kind": "text",
          "text": "之前我很紧张，之后我不紧张了。"
        }
      ],
      "script": [
        {
          "spotlight": "t1"
        },
        {
          "say": "常见的错误是：之前我很紧张，之后我不紧张了。"
        },
        {
          "say": "意思对了，可是看不见，也记不住。"
        },
        {
          "say": "换成同一个看得见的细节，变化才能留在读者心里。"
        },
        {
          "say": "写完以后，读一读自己的句子，看看有没有犯这个错误。"
        }
      ]
    },
    {
      "type": "slide",
      "title": "学法口诀",
      "blocks": [
        {
          "id": "h1",
          "kind": "heading",
          "text": "学法口诀"
        },
        {
          "id": "l1",
          "kind": "bullets",
          "items": [
            "之前之后都要写",
            "同个细节来对照",
            "心情变化藏里面",
            "读者一看就明了"
          ]
        }
      ],
      "script": [
        {
          "say": "来读学法口诀，跟我读。"
        },
        {
          "spotlight": "l1"
        },
        {
          "say": "之前之后都要写，同个细节来对照。心情变化藏里面，读者一看就明了。"
        },
        {
          "say": "写“那一刻”的时候，结尾就用前后对比。"
        },
        {
          "say": "口诀记住了，动笔的时候就不会忘。"
        }
      ]
    },
    {
      "type": "quiz",
      "title": "判断题",
      "intro": "先来判断对错。",
      "questions": [
        {
          "question": "写心情变化，只写“之前紧张，之后不紧张”就够了。",
          "options": [
            "对",
            "错"
          ],
          "answer": [
            1
          ],
          "analysis": "要用看得见的细节来对比。"
        },
        {
          "question": "用同一个细节前后对照，能写出心情的变化。",
          "options": [
            "对",
            "错"
          ],
          "answer": [
            0
          ],
          "analysis": "同一个细节前后不同，变化最明显。"
        }
      ]
    },
    {
      "type": "quiz",
      "title": "选择与句子练习",
      "intro": "再来做几道题。",
      "questions": [
        {
          "question": "哪一组前后对比写得最好？",
          "options": [
            "之前手冰凉，之后手心暖暖的。",
            "之前紧张，之后紧张。",
            "之前穿校服，之后也穿校服。"
          ],
          "answer": [
            0
          ],
          "analysis": "同一个细节（手），一冷一暖。"
        },
        {
          "question": "“之前觉得泳池像大海，之后觉得它像浴缸”写出了什么变化？",
          "options": [
            "从害怕到放松",
            "从开心到难过",
            "一直很害怕"
          ],
          "answer": [
            0
          ],
          "analysis": "泳池没变，是心情从害怕变成了放松。"
        },
        {
          "question": "前后对比最好用什么？",
          "options": [
            "同一个细节",
            "两个没关系的东西",
            "很多个成语"
          ],
          "answer": [
            0
          ],
          "analysis": "用同一个细节对照，变化最清楚。"
        }
      ]
    }
  ]
}

            "对",
            "错"
          ],
          "answer": [
            0
          ],
          "analysis": "用准确的数字来说明，是列数字。"
        },
        {
          "question": "介绍世界遗产，把网上的资料整段抄下来最好。",
          "options": [
            "对",
            "错"
          ],
          "answer": [
            1
          ],
          "analysis": "资料要挑选，再改成自己的话。"
        },
        {
          "question": "九寨沟是世界文化遗产。",
          "options": [
            "对",
            "错"
          ],
          "answer": [
            1
          ],
          "analysis": "九寨沟的山水是大自然形成的，是世界自然遗产。"
        }
      ]

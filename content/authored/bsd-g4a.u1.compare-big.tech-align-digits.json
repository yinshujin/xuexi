      "blocks": [
        {
          "id": "h1",
          "kind": "heading",
          "text": "只看第一个数字？"
        },
        {
          "id": "c1",
          "kind": "cards",
          "items": [
            {
              "id": "c1a",
              "text": "9 比 1 大，所以 986000 大？✗",
              "color": "gray"
            },
            {
              "id": "c1b",
              "text": "先比位数 ✓",
              "color": "green"
            }
          ]
        }
      ],
      "script": [
        {
          "laser": "c1a"
        },
        {
          "say": "有的同学只看第一个数字：9 比 1 大，就说 986000 比 1180000 大。"
        },
        {
          "say": "这是错的！986000 只有 6 位，1180000 有 7 位。"
        },
        {
          "laser": "c1b"
        },
        {
          "say": "一定要先比位数，位数相同时，才从最高位比数字。"
        }
      ]

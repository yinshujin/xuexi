{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "学数学",
  "version": "0.1.0",
  "identifier": "com.xuexi.math",
  "build": {
    "frontendDist": "../../../apps/web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @xuexi/web dev",
    "beforeBuildCommand": "pnpm --filter @xuexi/web build"
  },
  "app": {
    "windows": [
      {
        "title": "学数学",
        "width": 1200,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "北师大版小学数学：讲解课 + 专项练习",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

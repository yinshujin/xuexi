          "text": "先找每份同样多，"
        },
        {
          "id": "t2",
          "kind": "text",
          "text": "再数一共有几份；"
        },
        {
          "id": "t3",
          "kind": "text",
          "text": "同样多用乘法算，"
        },
        {
          "id": "t4",
          "kind": "text",
          "text": "不一样多用加法。"
        }
      ],
      "script": [
        {
          "say": "乘法小侦探的口诀来啦，先听老师读。"

          "kind": "bullets",
          "items": [
            "眼睛看，耳朵听",
            "鼻子闻，嘴巴尝",
            "小手摸一摸",
            "感官本领真不少"
          ]
        }
      ],
      "script": [
        {
          "say": "我们来念学法口诀，老师念一句，你跟一句。"
        },
        {
          "spotlight": "l1"
        },
        {
          "say": "眼睛看，耳朵听。"
        },
        {
          "say": "鼻子闻，嘴巴尝。"
        },
        {
          "say": "小手摸一摸，感官本领真不少。"
        },
        {
          "say": "说句子的时候，先想好用哪种感官，再配上对的身体部位。"
        }

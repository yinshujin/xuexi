      "questions": [
        {
          "question": "“霎时，潮头奔腾西去”这句写的是潮头过后的景象。",
          "options": [
            "对",
            "错"
          ],
          "answer": [
            0
          ],
          "analysis": "对。“霎时”之后潮头向西奔去，写的是潮头过后。"
        },
        {
          "question": "写景只能按时间顺序写，不能用别的顺序。",
          "options": [
            "对",
            "错"
          ],
          "answer": [
            1
          ],
          "analysis": "错。写景可以按时间顺序，也可以按其他顺序，比如按游览的地点。本课学的是时间顺序。"
        }
      ]
    },
    {
      "type": "quiz",
      "title": "选择与填空",
      "intro": "再来做几道选择题。",
      "questions": [
        {
          "question": "下面哪个词是表示时间的路标词？",
          "options": [
            "过了一会儿",
            "白色城墙",
            "人山人海"
          ],
          "answer": [
            0
          ],
          "analysis": "“过了一会儿”表示时间过去了，是时间路标词。"
        },
        {
          "question": "小明写看日落，下面哪种顺序最合理？",
          "options": [
            "落山后、落山前、落山时",
            "落山前、落山时、落山后",
            "落山时、落山后、落山前"
          ],
          "answer": [
            1
          ],
          "analysis": "按时间先后，应该是落山前、落山时、落山后。"
        },
        {
          "question": "“过了好久，钱塘江才恢复了平静。”这句属于（　）。",
          "options": [
            "潮来前",
            "潮来时",
            "潮头过后"
          ],
          "answer": [
            2
          ],
          "analysis": "潮头过去很久以后，江面才平静下来，属于潮头过后。"
        }
      ]
    }

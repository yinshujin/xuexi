      "blocks": [
        { "id": "h1", "kind": "heading", "text": "Where do animals live?" },
        { "id": "t1", "kind": "text", "text": "动物住在哪里？周末去深圳野生动物园看一看！" },
        { "id": "c1", "kind": "cards", "items": [
          { "id": "c1a", "text": "people 住在 city、farm", "color": "blue" },

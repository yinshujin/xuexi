# Copy to /srv/xuexi/.env on the server (deploy.sh --init does this once) and edit.
# Never commit the real .env.

# Your domain, DNS A record pointing at this server. Leave empty (or put the IP)
# to serve plain HTTP on port 80 - but PWA install/offline and the Android APK
# need HTTPS, so a domain is strongly recommended.
SITE_DOMAIN=

# Family access code typed on each device (>= 8 chars; longer is better).
# Changing it logs out every device.
FAMILY_CODE=change-me-family-code

# Random secret for signing login tokens (>= 32 chars). Generate with:
#   openssl rand -base64 48
# Changing it logs out every device.
TOKEN_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Optional: comma-separated allowed CORS origins for the API ('*' = any; the API
# uses bearer tokens, no cookies, so '*' is fine).
CORS_ORIGINS=*

# Optional: mirrors when Docker Hub / npm are slow from mainland China, e.g.
#   NODE_IMAGE=mirror.ccs.tencentyun.com/library/node:22-alpine
#   CADDY_IMAGE=mirror.ccs.tencentyun.com/library/caddy:2-alpine
#   NPM_REGISTRY=https://registry.npmmirror.com
NODE_IMAGE=node:22-alpine
CADDY_IMAGE=caddy:2-alpine
NPM_REGISTRY=https://registry.npmjs.org
# Optional: PEM file with an extra CA for npm during the image build (only
# needed behind a TLS-intercepting proxy).
NPM_CA_FILE=/dev/null

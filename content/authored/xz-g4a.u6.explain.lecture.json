    {
      "type": "quiz",
      "title": "句子练习",
      "intro": "最后练一练句子。",
      "questions": [
        {
          "question": "哪一句把资料改成了自己的话？",
          "options": [
            "该遗址集防卫、居住于一体。",
            "碉楼既能防坏人，又能住人。",
            "碉楼很好。"
          ],
          "answer": [
            1
          ],
          "analysis": "把难懂的资料换成了好懂的自己的话，意思没变。"
        },
        {
          "question": "哪一句数字写得最稳妥？",
          "options": [
            "长城全长两万多千米。",
            "长城全长正好两万千米。",
            "长城有一亿千米长。"
          ],
          "answer": [
            0
          ],
          "analysis": "“两万多千米”和资料一致，其他两句都不准确。"
        }

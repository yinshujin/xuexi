      "questions": [
        {
          "question": "用竖式算 25 + 38，进位的小 1 应该写在哪里？",
          "options": ["个位下面", "十位下面、横线上面", "得数的最前面"],
          "answer": [1],
          "analysis": "个位 5 + 8 = 13，满十向十位进 1，小 1 写在十位下面、横线上面。十位 2 + 3 + 1 = 6，25 + 38 = 63。"
        },
        {
          "question": "竖式 46 + 29：个位写 5 进 1，十位 4 + 2 + 1 = （　），得数是（　）。",
          "options": ["7，75", "6，65", "7，65"],
          "answer": [0],
          "analysis": "个位 6 + 9 = 15，写 5 进 1。十位要加上小 1：4 + 2 + 1 = 7，所以 46 + 29 = 75。选 65 是忘了加进位的 1。"
        },
        {
          "question": "秋游时，奇思拍了 37 张照片，妙想拍了 55 张。两人一共拍了（　）张。",
          "options": ["82", "18", "92"],
          "answer": [2],
          "analysis": "求一共，用加法：37 + 55 = 92（张）。个位 7 + 5 = 12，立刻写小 1；十位 3 + 5 + 1 = 9。得 82 是忘了加小 1。"

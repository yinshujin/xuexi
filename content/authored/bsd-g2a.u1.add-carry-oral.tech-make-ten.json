      "questions": [
        {
          "question": "用凑十法算 27 + 8，要把 8 分成（　）。",
          "options": ["2 和 6", "3 和 5", "4 和 4"],
          "answer": [1],
          "analysis": "27 的个位 7 差 3 凑成十，所以把 8 分成 3 和 5：27 + 3 = 30，30 + 5 = 35。"
        },
        {
          "question": "算 36 + 25：先算 36 + 20 = 56，再用凑十法算 56 + 5 = （　）。",
          "options": ["61", "51", "71"],
          "answer": [0],
          "analysis": "56 差 4 凑成十，把 5 分成 4 和 1：56 + 4 = 60，60 + 1 = 61。所以 36 + 25 = 61。"
        },
        {
          "question": "图书角有 48 本书，同学们又捐来 9 本。现在一共有（　）本。",
          "options": ["47", "39", "57"],
          "answer": [2],
          "analysis": "求一共有多少本，用加法。48 差 2 凑成十，把 9 分成 2 和 7：48 + 2 = 50，50 + 7 = 57（本）。写成 47 是忘了十位多 1。"
        }
      ]
    }
